#!/bin/sh

BIN=/opt/sbin/sign-craze
STATE=/opt/etc/sign-craze/state.json

case "$1" in
    install|configure|upgrade|abort-upgrade|abort-remove)
        if [ -f "$STATE" ]; then
            # Upgrade path: state.json уже существует — сервис был настроен ранее.
            status=$("$BIN" --status 2>/dev/null || true)
            case "$status" in
                *running*|*active*)
                    "$BIN" --restart || true
                    echo "sign-craze: --restart выполнен после opkg upgrade"
                    ;;
                *)
                    echo "sign-craze: сервис не запущен, restart пропущен"
                    ;;
            esac
        else
            # Fresh install path: только подсказка, никакого автозапуска.
            echo ""
            echo "sign-craze установлен в $BIN"
            echo ""
            echo "Для настройки запустите одну из команд:"
            echo "  sign-craze --install           (интерактивный мастер настройки)"
            echo "  sign-craze --install-auto       (автоматическая настройка с параметрами по умолчанию)"
            echo ""
            echo "После настройки запустите сервис:"
            echo "  sign-craze --service-start"
            echo ""
        fi
        ;;
esac

exit 0
