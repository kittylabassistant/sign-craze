#!/bin/sh
# preinst не использует set -e: opkg на роутерах запускает через busybox ash,
# и preinst должен возвращать 0 даже если opkg или stat недоступны.

BIN=/opt/sbin/sign-craze

case "$1" in
    install|upgrade|abort-upgrade)
        if [ -f "$BIN" ]; then
            # Проверяем, принадлежит ли бинарь opkg-пакету.
            # Если opkg search возвращает пустоту — файл установлен вручную (install.sh).
            owned=$(opkg search "$BIN" 2>/dev/null || true)
            if [ -z "$owned" ]; then
                mv "$BIN" "${BIN}.pre-opkg" || true
                echo "sign-craze: существующий бинарь сохранён как ${BIN}.pre-opkg"
            fi
        fi
        ;;
esac

exit 0
