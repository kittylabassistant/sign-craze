{
  "dns": {
    "final": "remote",
    "rules": [
      {
        "rule_set": [
          "geosite-ru"
        ],
        "server": "local"
      }
    ],
    "servers": [
      {
        "detour": "proxy-out",
        "server": "8.8.8.8",
        "tag": "remote",
        "type": "tls"
      },
      {
        "detour": "direct",
        "server": "223.5.5.5",
        "tag": "local",
        "type": "udp"
      }
    ]
  },
  "inbounds": [
    {
      "address": [
        "172.19.0.1/30",
        "fdfe:dcba:9876::1/126"
      ],
      "auto_route": false,
      "interface_name": "signbox-tun",
      "mtu": 1500,
      "sniff": true,
      "stack": "system",
      "tag": "tun-in",
      "type": "tun"
    }
  ],
  "log": {
    "level": "info",
    "output": "/opt/var/log/sign-craze/sing-box.log",
    "timestamp": true
  },
  "outbounds": [
    {
      "server": "1.2.3.4",
      "server_port": 1080,
      "tag": "proxy-out",
      "type": "socks"
    },
    {
      "tag": "direct",
      "type": "direct"
    }
  ],
  "route": {
    "auto_detect_interface": true,
    "default_domain_resolver": "local",
    "final": "proxy-out",
    "rule_set": [
      {
        "download_detour": "direct",
        "format": "binary",
        "tag": "geosite-blocked",
        "type": "remote",
        "url": "https://github.com/kittylabassistant/sign-craze-dat/releases/latest/download/geosite-blocked.srs"
      },
      {
        "download_detour": "direct",
        "format": "binary",
        "tag": "geosite-ru",
        "type": "remote",
        "url": "https://github.com/kittylabassistant/sign-craze-dat/releases/latest/download/geosite-ru.srs"
      }
    ],
    "rules": [
      {
        "action": "resolve",
        "inbound": "tun-in",
        "strategy": "prefer_ipv4"
      },
      {
        "action": "sniff",
        "inbound": "tun-in"
      },
      {
        "action": "hijack-dns",
        "protocol": "dns"
      },
      {
        "outbound": "direct",
        "rule_set": [
          "geosite-ru"
        ]
      },
      {
        "outbound": "proxy-out",
        "rule_set": [
          "geosite-blocked"
        ]
      }
    ]
  }
}
