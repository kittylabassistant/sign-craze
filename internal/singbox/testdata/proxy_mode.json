{
  "dns": {
    "final": "remote",
    "rules": [
      {
        "outbound": "any",
        "server": "local"
      },
      {
        "rule_set": [
          "geosite-ru"
        ],
        "server": "local"
      }
    ],
    "servers": [
      {
        "detour": "proxy-out",
        "server": "8.8.8.8",
        "tag": "remote",
        "type": "tls"
      },
      {
        "detour": "direct",
        "server": "223.5.5.5",
        "tag": "local",
        "type": "udp"
      }
    ]
  },
  "inbounds": [
    {
      "domain_strategy": "prefer_ipv4",
      "listen": "::",
      "listen_port": 7895,
      "mark": 83,
      "sniff": true,
      "sniff_override_destination": false,
      "tag": "tproxy-in",
      "tcp_fast_open": false,
      "type": "tproxy"
    }
  ],
  "log": {
    "level": "info",
    "output": "/opt/var/log/sign-craze/sing-box.log",
    "timestamp": true
  },
  "outbounds": [
    {
      "server": "1.2.3.4",
      "server_port": 1080,
      "tag": "proxy-out",
      "type": "socks"
    },
    {
      "tag": "direct",
      "type": "direct"
    },
    {
      "tag": "block",
      "type": "block"
    },
    {
      "tag": "dns-out",
      "type": "dns"
    }
  ],
  "route": {
    "auto_detect_interface": true,
    "final": "proxy-out",
    "rule_set": [
      {
        "download_detour": "direct",
        "format": "binary",
        "tag": "geosite-blocked",
        "type": "remote",
        "url": "https://github.com/kittylabassistant/sign-craze-dat/releases/latest/download/geosite-blocked.srs"
      },
      {
        "download_detour": "direct",
        "format": "binary",
        "tag": "geosite-ru",
        "type": "remote",
        "url": "https://github.com/kittylabassistant/sign-craze-dat/releases/latest/download/geosite-ru.srs"
      }
    ],
    "rules": [
      {
        "outbound": "dns-out",
        "protocol": "dns"
      },
      {
        "outbound": "direct",
        "rule_set": [
          "geosite-ru"
        ]
      },
      {
        "outbound": "proxy-out",
        "rule_set": [
          "geosite-blocked"
        ]
      }
    ]
  }
}
