    {
      "tag": "direct",
      "type": "direct"
    }
  ],
  "route": {
    "auto_detect_interface": true,
    "default_domain_resolver": "local",
    "final": "direct",
    "rule_set": [
      {
        "download_detour": "direct",
        "format": "binary",
        "tag": "geoip-ru",
        "type": "remote",
        "url": "https://github.com/SagerNet/sing-geoip/releases/latest/download/geoip-ru.srs"
