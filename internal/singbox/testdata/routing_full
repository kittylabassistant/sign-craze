        "url": "https://github.com/jameszeroX/zkeen-domains/releases/latest/download/zkeen-youtube.srs"
      }
    ],
    "rules": [
      {
        "action": "resolve",
        "inbound": "tun-in",
        "strategy": "prefer_ipv4"
      },
      {
        "action": "sniff",
        "inbound": "tun-in"
      },
      {
        "action": "hijack-dns",
        "inbound": "tun-in",
        "protocol": "dns"
      },
      {
        "action": "block",
        "network": "udp",
        "port": [
          135,
          137,
          138,
          139
        ]
      },
      {
        "action": "block",
        "rule_set": [
          "geosite-category-ads-all"
        ]
      },
      {
        "action": "block",
        "invert": true,
        "network": "udp",
        "port": [
          443
        ],
        "rule_set": [
          "geoip-ru"
        ]
      },
      {
        "network": "udp",
        "outbound": "vless-reality",
        "port_range": [
          "50000:50030"
        ]
      },
      {
        "outbound": "vless-reality",
        "rule_set": [
          "geosite-zkeen-domains",
          "geosite-zkeen-other",
          "geosite-zkeen-youtube"
        ]
      },
      {
        "ip_cidr": [
          "138.128.136.0/21",
          "162.158.0.0/15",
          "172.64.0.0/13"
        ],
