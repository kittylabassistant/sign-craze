{
  "dns": {
    "final": "remote",
    "rules": [],
    "servers": [
      {
        "detour": "out",
        "server": "8.8.8.8",
        "tag": "remote",
        "type": "tls"
      },
      {
        "tag": "local",
        "type": "local"
      }
    ]
  },
  "experimental": {
    "cache_file": {
      "enabled": true,
      "path": "/opt/var/lib/sign-craze/cache.db"
    },
    "clash_api": {
      "default_mode": "rule",
      "external_controller": "127.0.0.1:9094"
    }
  },
  "inbounds": [
    {
      "address": [
        "172.19.0.1/30",
        "fdfe:dcba:9876::1/126"
      ],
      "auto_route": false,
      "interface_name": "signbox-tun",
      "mtu": 1280,
      "stack": "gvisor",
      "tag": "tun-in",
      "type": "tun"
    }
  ],
  "log": {
    "level": "info",
    "output": "/opt/var/log/sign-craze/sing-box.log",
    "timestamp": true
  },
  "outbounds": [
    {
      "server": "0.0.0.0",
      "server_port": 1,
      "tag": "out",
      "type": "direct"
    },
    {
      "tag": "direct",
      "type": "direct"
    }
  ],
  "route": {
    "auto_detect_interface": true,
    "default_domain_resolver": "local",
    "final": "out",
    "rule_set": null,
    "rules": [
      {
        "action": "resolve",
        "inbound": "tun-in",
        "strategy": "prefer_ipv4"
      },
      {
        "action": "sniff",
        "inbound": "tun-in"
      },
      {
        "action": "hijack-dns",
        "inbound": "tun-in",
        "protocol": "dns"
      }
    ]
  }
}
