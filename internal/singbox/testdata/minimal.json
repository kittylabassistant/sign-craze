{
  "dns": {
    "final": "remote",
    "rules": [],
    "servers": [
      {
        "detour": "out",
        "server": "8.8.8.8",
        "tag": "remote",
        "type": "tls"
      },
      {
        "detour": "direct",
        "server": "223.5.5.5",
        "tag": "local",
        "type": "udp"
      }
    ]
  },
  "inbounds": [
    {
      "listen": "::",
      "listen_port": 7895,
      "routing_mark": 83,
      "tag": "tproxy-in",
      "tcp_fast_open": false,
      "type": "tproxy"
    }
  ],
  "log": {
    "level": "info",
    "output": "/opt/var/log/sign-craze/sing-box.log",
    "timestamp": true
  },
  "outbounds": [
    {
      "tag": "out",
      "type": "direct"
    },
    {
      "tag": "direct",
      "type": "direct"
    }
  ],
  "route": {
    "auto_detect_interface": true,
    "default_domain_resolver": "local",
    "final": "out",
    "rule_set": null,
    "rules": [
      {
        "action": "resolve",
        "inbound": "tproxy-in",
        "strategy": "prefer_ipv4"
      },
      {
        "action": "sniff",
        "inbound": "tproxy-in"
      },
      {
        "action": "hijack-dns",
        "protocol": "dns"
      }
    ]
  }
}
