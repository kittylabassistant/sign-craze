{
  "inbounds": [
    {
      "port": 7895,
      "protocol": "dokodemo-door",
      "settings": {
        "followRedirect": true,
        "network": "tcp,udp"
      },
      "sniffing": {
        "destOverride": [
          "http",
          "tls",
          "quic"
        ],
        "enabled": true
      },
      "streamSettings": {
        "sockopt": {
          "mark": 83,
          "tproxy": "tproxy"
        }
      },
      "tag": "tproxy-in"
    }
  ],
  "log": {
    "loglevel": "warning"
  },
  "outbounds": [
    {
      "protocol": "vless",
      "settings": {
        "vnext": [
          {
            "address": "xhttp.example.com",
            "port": 443,
            "users": [
              {
                "encryption": "none",
                "id": "cccccccc-dddd-eeee-ffff-000000000000"
              }
            ]
          }
        ]
      },
      "streamSettings": {
        "network": "xhttp",
        "security": "tls",
        "tlsSettings": {
          "fingerprint": "chrome",
          "serverName": "xhttp.example.com"
        },
        "xhttpSettings": {
          "host": "xhttp.example.com",
          "mode": "packet-up",
          "path": "/xhttp"
        }
      },
      "tag": "vless-xhttp-packetup"
    },
    {
      "protocol": "freedom",
      "tag": "direct"
    },
    {
      "protocol": "blackhole",
      "tag": "block"
    }
  ],
  "routing": {
    "domainStrategy": "AsIs",
    "rules": [
      {
        "inboundTag": [
          "tproxy-in"
        ],
        "outboundTag": "vless-xhttp-packetup",
        "type": "field"
      }
    ]
  }
}
